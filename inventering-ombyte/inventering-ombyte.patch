+          </div>
+          <div className="text-muted-foreground">{p.styck} st · {p.nomM3.toFixed(2)} m³</div>
+        </div>
+
+        {kanByta && (
+          <div className="space-y-3">
+            <p className="text-sm font-medium">
+              Vilket paket plockade du i stället för {paket.pktNr}?

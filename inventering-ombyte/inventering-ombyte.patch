+
+  test("B får inte vara ett paket som redan skannats (då står det ju kvar)", async () => {
+    const { omrade, fack } = await skapaOmradeOchFack("TEST_OmbyteSkannat");
+    const a = await skapaPost(omrade.id, fack.id, "TEST-A2");
